---
import Logo from './Logo.astro';

interface Props {
  footer: { demoNote: string; rights: string };
  base: string;
}
const { footer, base } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container ftr__inner">
    <div class="ftr__brand">
      <Logo href={`${base}/`} size={44} />
      <p class="ftr__meta mono">Juan Francisco Furfuri, {year}. {footer.rights}</p>
    </div>
    <p class="ftr__note">{footer.demoNote}</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: var(--sp-6);
  }

  .ftr__inner { display: grid; gap: var(--sp-5); }

  .ftr__brand { display: grid; gap: var(--sp-3); justify-items: start; }

  .ftr__meta {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .ftr__note {
    color: var(--text-dim);
    font-size: var(--step--1);
    max-width: 62ch;
  }

  @media (min-width: 800px) {
    .ftr__inner { grid-template-columns: auto 1fr; gap: var(--sp-7); align-items: start; }
    .ftr__note { justify-self: end; text-align: right; }
  }
</style>
