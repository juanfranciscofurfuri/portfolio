---
interface Props {
  approach: { heading: string; steps: { title: string; body: string }[] };
}
const { approach } = Astro.props;
---

<!-- Composición partida: el título queda fijo a la izquierda mientras los pasos
     pasan por la derecha. Es el único lugar del sitio donde algo se ancla. -->
<section class="section apr" id="approach">
  <div class="container apr__grid">
    <div class="apr__side">
      <h2 class="apr__title">{approach.heading}</h2>
      <p class="apr__hint mono">{String(approach.steps.length).padStart(2, '0')}</p>
    </div>

    <ol class="apr__list">
      {approach.steps.map((step, i) => (
        <li class="apr__step lit reveal" style={`--i:${i}`} data-lit>
          <span class="apr__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="apr__stepTitle">{step.title}</h3>
            <p class="apr__stepBody">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .apr__grid { display: grid; gap: var(--sp-6); }

  .apr__title {
    font-size: var(--step-3);
    letter-spacing: -0.045em;
  }

  .apr__hint {
    margin-top: var(--sp-3);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--text-dim);
  }

  .apr__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }

  .apr__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-4);
    align-items: start;
    padding: var(--sp-5) var(--sp-3);
    background: var(--bg);
    transition: background-color 0.6s var(--ease);
  }

  .apr__step:hover { background: var(--bg-raised); }

  .apr__num {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    padding-top: 0.45rem;
  }

  .apr__stepTitle {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .apr__stepBody {
    margin-top: var(--sp-2);
    color: var(--text-muted);
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .apr__grid { grid-template-columns: 0.8fr 1.2fr; gap: var(--sp-7); align-items: start; }
    .apr__side { position: sticky; top: 7rem; }
    .apr__step { padding: var(--sp-6) var(--sp-4); gap: var(--sp-5); }
  }
</style>
