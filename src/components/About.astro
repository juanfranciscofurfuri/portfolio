---
interface Props {
  about: { heading: string; body: string[]; cvLabel: string };
  cvHref: string;
}
const { about, cvHref } = Astro.props;
---

<section class="section" id="about">
  <div class="container">
    <div class="about__inner">
      <h2 class="about__heading">{about.heading}</h2>
      {about.body.map((p) => <p class="about__p">{p}</p>)}
      <a class="btn btn--ghost about__cv" href={cvHref} download>{about.cvLabel}</a>
    </div>
  </div>
</section>

<style>
  .about__inner { max-width: 68ch; }
  .about__heading { font-size: var(--step-3); }
  .about__p {
    margin-top: var(--sp-4);
    color: var(--text-muted);
    font-size: var(--step-1);
  }
  .about__cv { margin-top: var(--sp-5); }
</style>
