---
import Field from './Field.astro';

interface Props {
  hero: {
    eyebrow: string;
    headlineA: string;
    headlineB: string;
    sub: string;
    ctaPrimary: string;
    ctaSecondary: string;
  };
  base: string;
}
const { hero, base } = Astro.props;

// El título se parte en palabras para que entren de a una. El movimiento es el
// contenido: la frase se arma delante del que mira.
const wordsA = hero.headlineA.split(' ');
const wordsB = hero.headlineB.split(' ');
let i = 0;
---

<section class="hero" data-lit>
  <Field />
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="tag tag--accent hero__eyebrow"><span class="dot" aria-hidden="true"></span>{hero.eyebrow}</p>

    <h1 class="hero__title">
      <span class="line">
        {wordsA.map((w) => <span class="w" style={`--w:${i++}`}><span>{w}</span></span>)}
      </span>
      <span class="line line--muted">
        {wordsB.map((w) => <span class="w" style={`--w:${i++}`}><span>{w}</span></span>)}
      </span>
    </h1>

    <div class="hero__row">
      <p class="hero__sub">{hero.sub}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={`${base}/#contact`} data-magnetic="8">
          {hero.ctaPrimary}
          <span class="btn__ico" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 12 12" fill="none">
              <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor"
                    stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
        <a class="btn btn--ghost" href={`${base}/#work`}>
          {hero.ctaSecondary}
          <span class="btn__ico" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 12 12" fill="none">
              <path d="M6 2.5v7M2.5 6h7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    min-height: min(86dvh, 800px);
    padding-block: var(--sp-6) var(--sp-7);
  }

  /* El resplandor sigue al cursor. Es el mismo gesto que se repite después en
     cada tarjeta. */
  .hero__glow {
    position: absolute;
    inset: -20% 0 0;
    z-index: -1;
    background: radial-gradient(560px circle at var(--px) var(--py),
                rgba(240, 166, 63, 0.12), transparent 62%);
    mask-image: linear-gradient(180deg, #000 70%, transparent);
    transition: background 0.25s linear;
  }

  .hero__eyebrow { margin-bottom: var(--sp-6); }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(240, 166, 63, 0.18);
  }

  .hero__title {
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .line { display: block; }
  .line--muted { color: var(--text-dim); }

  /* Sin recorte. La versión anterior metía cada palabra en una caja con
     overflow:hidden, y esa caja hereda line-height 0.98: más baja que las
     letras, así que les comía la parte de arriba. Un titular cortado no vale
     ningún efecto. */
  .w {
    display: inline-block;
    padding-right: 0.24em;
  }

  .w > span { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    .w > span {
      animation: rise 1s var(--ease) both;
      animation-delay: calc(var(--w) * 55ms + 80ms);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(0.42em); }
      to { opacity: 1; transform: none; }
    }
  }

  .hero__row {
    margin-top: var(--sp-5);
    display: grid;
    gap: var(--sp-4);
  }

  .hero__sub {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 40ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }

  @media (min-width: 900px) {
    .hero__row {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--sp-6);
      margin-top: var(--sp-6);
    }
  }
</style>
