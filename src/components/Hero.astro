---
import { Image } from 'astro:assets';
import gropius from '../assets/work/espaciogropius.jpg';

interface Props {
  hero: {
    headline: string;
    sub: string;
    ctaPrimary: string;
    ctaSecondary: string;
    imageAlt: string;
    imageCaption: string;
  };
  base: string;
}
const { hero, base } = Astro.props;
---

<section class="hero">
  <div class="container">
    <h1 class="hero__title enter" style="--d: 0ms">{hero.headline}</h1>

    <div class="hero__row">
      <div class="hero__copy">
        <p class="hero__sub enter" style="--d: 90ms">{hero.sub}</p>
        <div class="hero__actions enter" style="--d: 170ms">
          <a class="btn btn--primary" href={`${base}/#contact`}>{hero.ctaPrimary}</a>
          <a class="btn btn--ghost" href={`${base}/#work`}>{hero.ctaSecondary}</a>
        </div>
      </div>

      <figure class="hero__media enter" style="--d: 250ms">
        <Image
          src={gropius}
          alt={hero.imageAlt}
          widths={[560, 800, 1120]}
          sizes="(min-width: 960px) 48vw, 92vw"
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{hero.imageCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--line);
  }

  .hero__title {
    font-size: clamp(2.5rem, 1.55rem + 4.4vw, 4.6rem);
    letter-spacing: -0.035em;
    max-width: 17ch;
  }

  .hero__row {
    margin-top: var(--sp-5);
    display: grid;
    gap: var(--sp-5);
  }

  .hero__sub {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 42ch;
  }

  .hero__actions {
    margin-top: var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .hero__media img {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .hero__media figcaption {
    margin-top: var(--sp-2);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  @media (min-width: 960px) {
    .hero { padding-top: var(--sp-6); padding-bottom: var(--sp-7); }
    .hero__row {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--sp-6);
      align-items: start;
    }
    .hero__copy { padding-top: var(--sp-2); }
  }

  /* Entrance: keyframes exist only when motion is welcome, so with reduced
     motion the content simply renders in place. */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: enter 0.8s var(--ease) both;
      animation-delay: var(--d, 0ms);
    }
    @keyframes enter {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
