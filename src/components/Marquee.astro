---
// Una sola cinta en todo el sitio. Dos copias del contenido y una traslación:
// cuando la primera copia termina de salir, la segunda ya ocupa su lugar.
interface Props { items: string[] }
const { items } = Astro.props;
---

<div class="mq" aria-hidden="true">
  <div class="mq__track">
    {[0, 1].map(() => (
      <ul class="mq__set">
        {items.map((t) => (
          <li class="mq__item mono">{t}<span class="mq__sep">/</span></li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .mq {
    overflow: hidden;
    padding-block: var(--sp-4);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.42) 40%, rgba(0, 0, 0, 0.42) 60%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .mq__track { display: flex; width: max-content; }

  .mq__set {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mq__item {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .mq__sep { color: var(--accent); opacity: 0.55; }

  @media (prefers-reduced-motion: no-preference) {
    .mq__track { animation: slide 38s linear infinite; }
    @keyframes slide {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
  }
</style>
