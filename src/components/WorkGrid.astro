---
import SectionBg from './SectionBg.astro';
import { Image } from 'astro:assets';
import gropius from '../assets/work/espaciogropius.jpg';
import matix from '../assets/work/matix.jpg';
import demoVinedo from '../assets/work/demo-vinedo.png';
import demoEstudio from '../assets/work/demo-estudio.png';

const images: Record<string, ImageMetadata> = {
  espaciogropius: gropius,
  matix: matix,
  'demo-vinedo': demoVinedo,
  'demo-estudio': demoEstudio,
};

interface Item {
  slug: string;
  name: string;
  kind: string;
  summary: string;
  tech: string;
  href?: string;
  repo?: string;
  image?: string;
  demo?: boolean;
  demoLabel?: string;
}

interface Props {
  work: { heading: string; liveLabel: string; repoLabel: string; demoLinkLabel: string; items: Item[] };
}
const { work } = Astro.props;

// Bento: anchos distintos por posición, sin celdas vacías. La grilla es de 12
// columnas y el patrón se repite cada cuatro piezas.
const spans = [7, 5, 5, 7, 6, 6];
---

<section class="section work" id="work">
  <SectionBg variant="grid" />
  <div class="container">
    <header class="work__head">
      <h2 class="work__title">{work.heading}</h2>
      <span class="work__count mono">{String(work.items.length).padStart(2, '0')}</span>
    </header>

    <div class="bento">
      {work.items.map((item, idx) => {
        const span = spans[idx % spans.length];
        const img = item.image ? images[item.image] : null;
        return (
          <article
            class:list={['tile', 'shell', 'lit', 'reveal', !img && 'tile--text']}
            style={`--span:${span}; --i:${idx % 2}`}
            data-lit
            data-tilt="4"
          >
            <div class="core tile__core">
              {img && (
                <div class="tile__media">
                  <Image
                    src={img}
                    alt={item.name}
                    widths={[520, 780, 1040]}
                    sizes="(min-width: 1000px) 50vw, 92vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                  />
                  <span class="tile__glare" aria-hidden="true"></span>
                </div>
              )}

              <div class="tile__body">
                <p class:list={['tile__kind', 'mono', item.demo && 'tile__kind--demo']}>
                  {item.demo ? item.demoLabel : item.kind}
                </p>
                <h3 class="tile__name">{item.name}</h3>
                <p class="tile__sum">{item.summary}</p>

                <div class="tile__foot">
                  <p class="tile__tech mono">{item.tech}</p>
                  <div class="tile__links">
                    {item.href && (
                      <a
                        class="tile__link"
                        href={item.href}
                        target={item.demo ? undefined : '_blank'}
                        rel={item.demo ? undefined : 'noopener'}
                      >
                        {item.demo ? work.demoLinkLabel : work.liveLabel}
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor"
                                stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    )}
                    {item.repo && (
                      <a class="tile__link tile__link--dim" href={item.repo} target="_blank" rel="noopener">
                        {work.repoLabel}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Contiene la capa de fondo, que va en absoluto. */
  .work { position: relative; isolation: isolate; }

  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }

  .work__title {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }

  .work__count {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--text-dim);
  }

  .bento { display: grid; gap: var(--sp-4); }

  .tile {
    display: block;
    transition: transform 0.7s var(--ease), border-color 0.7s var(--ease);
  }

  .tile:hover { border-color: rgba(240, 166, 63, 0.28); }

  .tile__core {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .tile__media { position: relative; overflow: hidden; }

  .tile__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.1s var(--ease), filter 0.7s var(--ease);
    filter: saturate(0.85) brightness(0.88);
  }

  .tile:hover .tile__media img {
    transform: scale(1.035);
    filter: saturate(1) brightness(1);
  }

  .tile__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(300px circle at var(--px) var(--py),
                rgba(255, 255, 255, 0.14), transparent 62%);
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .tile:hover .tile__glare { opacity: 1; }

  .tile__body {
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tile__kind {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-dim);
  }

  .tile__kind--demo { color: var(--accent); }

  .tile__name {
    margin-top: var(--sp-2);
    font-size: var(--step-2);
    letter-spacing: -0.035em;
  }

  .tile__sum {
    margin-top: var(--sp-2);
    color: var(--text-muted);
    max-width: 56ch;
  }

  .tile__foot {
    margin-top: auto;
    padding-top: var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .tile__tech {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .tile__links { display: flex; gap: var(--sp-4); }

  .tile__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.5s var(--ease);
  }

  .tile__link:hover { gap: 0.6rem; }
  .tile__link--dim { color: var(--text-muted); }

  /* La tipografía de las piezas sin imagen sube de escala: sin foto, el peso lo
     tiene que poner el texto. */
  .tile--text .tile__body { padding-block: var(--sp-6); }
  .tile--text .tile__name { font-size: var(--step-3); }

  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }
    .tile { grid-column: span var(--span); }
  }
</style>
