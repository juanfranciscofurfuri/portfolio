---
import SectionBg from './SectionBg.astro';
interface Props {
  story: { heading: string; body: string[]; note: string };
}
const { story } = Astro.props;
const words = story.heading.split(' ');
---

<section class="story" data-lit>
  <span class="glow" aria-hidden="true"></span>
  <SectionBg variant="embers" />
  <div class="container story__inner">
    <!-- El título se arma palabra por palabra mientras entra: el movimiento
         obliga a leerlo, que es justo lo que esta sección necesita. -->
    <h2 class="story__heading">
      {words.map((w, i) => (
        <span class="sw reveal" style={`--i:${i}`}>{w}</span>
      ))}
    </h2>

    <div class="story__grid">
      <div class="story__cols">
        {story.body.map((p, i) => <p class="reveal" style={`--i:${i}`}>{p}</p>)}
      </div>

      <aside class="story__note shell reveal" style="--i:2">
        <div class="core story__noteCore">
          <span class="story__quote mono" aria-hidden="true">/*</span>
          <p>{story.note}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
    .story {
    position: relative;
    isolation: isolate;
    padding-block: var(--sp-8);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.5) 26%, rgba(0, 0, 0, 0.5) 74%, transparent);
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    mask-image: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
  }

  .glow {
    background: radial-gradient(900px circle at var(--px) var(--py),
                rgba(240, 166, 63, 0.09), transparent 62%);
  }

  .story__heading {
    font-size: var(--step-3);
    max-width: 22ch;
    letter-spacing: -0.045em;
  }

  .sw { display: inline-block; padding-right: 0.26em; }

  .story__grid {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-5);
  }

  .story__cols p {
    color: var(--text-muted);
    font-size: var(--step-1);
    max-width: 54ch;
  }

  .story__cols p + p { margin-top: var(--sp-4); }

  .story__noteCore {
    padding: var(--sp-5);
    display: grid;
    gap: var(--sp-3);
  }

  .story__quote {
    font-size: 1.6rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.6;
  }

  .story__noteCore p {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  @media (min-width: 900px) {
    .story__grid { grid-template-columns: 1.25fr 0.75fr; gap: var(--sp-6); align-items: start; }
    .story__note { position: sticky; top: 6rem; }
  }
</style>
