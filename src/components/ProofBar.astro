---
interface Props {
  items: { label: string; value: string; note?: string; href?: string }[];
}
const { items } = Astro.props;
---

<section class="proof">
  <div class="container proof__grid">
    {items.map((item) => (
      <div class="proof__item">
        <p class="proof__label mono">{item.label}</p>
        <p class="proof__value">{item.value}</p>
        {item.href ? (
          <a class="proof__note proof__note--link" href={item.href} target="_blank" rel="noopener">
            {item.note}
          </a>
        ) : (
          <p class="proof__note">{item.note}</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .proof {
    padding-block: var(--sp-5);
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4) var(--sp-5);
  }

  .proof__label {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
  }

  .proof__value {
    margin-top: 0.35rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .proof__note {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.45;
  }

  .proof__note--link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 860px) {
    .proof__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
