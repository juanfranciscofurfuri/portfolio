---
interface Props {
  items: { label: string; value: string; note?: string; href?: string }[];
}
const { items } = Astro.props;
---

<section class="proof">
  <div class="container proof__grid">
    {items.map((item) => (
      <div class="proof__item">
        <p class="proof__label mono">{item.label}</p>
        <p class="proof__value">{item.value}</p>
        {item.href ? (
          <a class="proof__note proof__note--link" href={item.href} target="_blank" rel="noopener">
            {item.note}
          </a>
        ) : (
          <p class="proof__note">{item.note}</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  /* Deja aire arriba porque la captura del hero se le monta encima. */
  .proof {
    padding-top: calc(var(--sp-7) + var(--sp-6));
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--line);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5) var(--sp-4);
  }

  .proof__item {
    padding-left: var(--sp-4);
    border-left: 1px solid var(--line);
  }

  .proof__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-dim);
  }

  .proof__value {
    margin-top: 0.5rem;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .proof__note {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .proof__note--link {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 166, 63, 0.35);
    transition: border-color 0.5s var(--ease);
  }

  .proof__note--link:hover { border-bottom-color: var(--accent); }

  @media (min-width: 900px) {
    .proof__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
