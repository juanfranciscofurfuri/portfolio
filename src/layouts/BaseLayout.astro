---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import Aurora from '../components/Aurora.astro';

interface Props {
  lang: 'en' | 'es';
  title: string;
  description: string;
  /** Ruta sin prefijo de idioma, por ejemplo "" para el inicio */
  path?: string;
  /** Páginas que no deben aparecer en Google, como las de gracias */
  noindex?: boolean;
}

const { lang, title, description, path = '', noindex = false } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const clean = path.replace(/^\/|\/$/g, '');
const enUrl = `${site}/${clean ? clean + '/' : ''}`;
const esUrl = `${site}/es/${clean ? clean + '/' : ''}`;
const canonical = lang === 'en' ? enUrl : esUrl;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Juan Francisco Furfuri',
  alternateName: 'JF web dev',
  jobTitle: 'Web Developer',
  email: 'mailto:juanfrafurfuri@gmail.com',
  url: site,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Godoy Cruz',
    addressRegion: 'Mendoza',
    addressCountry: 'AR',
  },
  knowsLanguage: ['es', 'en'],
  sameAs: [
    'https://github.com/juanfranciscofurfuri',
    'https://www.linkedin.com/in/juan-francisco-furfuri-altamira-2b8a74336/',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#060607" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Ir al contenido'}</a>
    <Aurora />
    <div class="progress" aria-hidden="true"></div>
    <slot />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      // 1. Entrada al scrollear ------------------------------------------------
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (items.length && !reduced) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }

      // El resto es puro adorno: en táctil y en movimiento reducido no corre.
      if (fine && !reduced) {
        let frame = 0;
        const write = (fn: () => void) => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(fn);
        };

        // 2. Foco que sigue al cursor ----------------------------------------
        document.querySelectorAll<HTMLElement>('[data-lit]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            write(() => {
              el.style.setProperty('--px', `${((e.clientX - r.left) / r.width) * 100}%`);
              el.style.setProperty('--py', `${((e.clientY - r.top) / r.height) * 100}%`);
            });
          });
        });

        // 3. Inclinación 3D ---------------------------------------------------
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          const max = Number(el.dataset.tilt) || 7;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            write(() => {
              el.style.setProperty('--tilt-y', `${x * max * 2}deg`);
              el.style.setProperty('--tilt-x', `${-y * max * 2}deg`);
            });
          });
          el.addEventListener('pointerleave', () => {
            write(() => {
              el.style.setProperty('--tilt-y', '0deg');
              el.style.setProperty('--tilt-x', '0deg');
            });
          });
        });

        // 4. Botones magnéticos ----------------------------------------------
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          const pull = Number(el.dataset.magnetic) || 10;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) / (r.width / 2);
            const y = (e.clientY - r.top - r.height / 2) / (r.height / 2);
            write(() => {
              el.style.transform = `translate(${x * pull}px, ${y * pull * 0.6}px)`;
            });
          });
          el.addEventListener('pointerleave', () => {
            write(() => { el.style.transform = ''; });
          });
        });
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: var(--sp-3);
        z-index: 100;
        background: var(--accent);
        color: var(--accent-ink);
        padding: 0.6rem 1rem;
        border-radius: var(--r-pill);
        text-decoration: none;
        font-weight: 500;
      }
      .skip:focus { left: var(--sp-4); }

      /* Barra de progreso: la escribe el propio scroll del navegador, sin
         JavaScript. Donde no existe la propiedad, simplemente no aparece. */
      .progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        z-index: 50;
        transform-origin: 0 50%;
        transform: scaleX(0);
        background: linear-gradient(90deg, var(--accent-deep), var(--accent-hot));
      }

      @supports (animation-timeline: scroll()) {
        @media (prefers-reduced-motion: no-preference) {
          .progress {
            animation: grow linear both;
            animation-timeline: scroll(root block);
          }
          @keyframes grow {
            from { transform: scaleX(0); }
            to { transform: scaleX(1); }
          }
        }
      }
    </style>
  </body>
</html>
