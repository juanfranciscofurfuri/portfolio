---
import { Image } from 'astro:assets';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import '@fontsource-variable/instrument-sans';
import justicia from '../../../assets/demo-legal/justicia.jpg';
import fachada from '../../../assets/demo-legal/fachada.jpg';

const areas = [
  {
    name: 'Derecho laboral',
    body: 'Despidos, accidentes de trabajo, trabajo no registrado. Representamos al trabajador y también a la empresa, nunca en el mismo conflicto.',
  },
  {
    name: 'Familia y sucesiones',
    body: 'Divorcios, cuota alimentaria, régimen de comunicación, declaratoria de herederos y partición de bienes.',
  },
  {
    name: 'Daños y perjuicios',
    body: 'Accidentes de tránsito, mala praxis, reclamos a compañías de seguro que dilatan el pago.',
  },
  {
    name: 'Derecho comercial',
    body: 'Constitución de sociedades, contratos entre socios, conflictos societarios y cobro de deudas.',
  },
  {
    name: 'Defensa del consumidor',
    body: 'Reclamos contra bancos, telefónicas y empresas de servicios. La mayoría se resuelve sin llegar a juicio.',
  },
  {
    name: 'Contratos',
    body: 'Redacción y revisión de alquileres, locación de obra, distribución y confidencialidad.',
  },
];

const steps = [
  {
    t: 'Primera reunión',
    b: 'Cuarenta minutos, sin cargo, presencial o por videollamada. Salís sabiendo si tenés un caso y cuánto puede tardar.',
  },
  {
    t: 'Presupuesto por escrito',
    b: 'Honorarios cerrados o pacto de cuota litis, según el caso. Queda firmado antes de que empecemos.',
  },
  {
    t: 'Novedades cada quince días',
    b: 'Recibís un mail con qué pasó en el expediente, aunque no haya pasado nada. Sin tener que llamar a preguntar.',
  },
];

const team = [
  { name: 'Marina Ávila', role: 'Socia. Laboral y daños', extra: 'Matrícula 4.812, Colegio de Abogados de Mendoza. UNCuyo, 2004.' },
  { name: 'Rodrigo Nieto', role: 'Socio. Comercial y contratos', extra: 'Matrícula 5.103, Colegio de Abogados de Mendoza. UNCuyo, 2007.' },
  { name: 'Paula Sanguinetti', role: 'Asociada. Familia y sucesiones', extra: 'Matrícula 7.640, Colegio de Abogados de Mendoza. UNCuyo, 2016.' },
];
---

<DemoLayout
  title="Ávila Nieto Abogados - Estudio jurídico en Mendoza"
  description="Estudio jurídico en Mendoza. Laboral, familia, sucesiones, daños y derecho comercial. Primera consulta sin cargo."
  path="demo/estudio"
  themeColor="#16233f"
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="nav__brand" href="#top">
        <span class="nav__mark">AN</span>
        <span>Ávila Nieto <span class="nav__sub">Abogados</span></span>
      </a>
      <nav class="nav__links" aria-label="Secciones">
        <a href="#areas">Áreas</a>
        <a href="#trabajo">Cómo trabajamos</a>
        <a href="#equipo">El equipo</a>
      </nav>
      <a class="btn nav__cta" href="#consulta">Pedir una consulta</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero__grid">
        <div>
          <h1 class="hero__title">Un abogado que te contesta el teléfono</h1>
          <p class="hero__sub">
            Estudio jurídico en la ciudad de Mendoza. La primera consulta no se cobra
            y de la reunión salís sabiendo si conviene litigar o no.
          </p>
          <div class="hero__cta">
            <a class="btn btn--lg" href="#consulta">Pedir una consulta</a>
            <a class="link" href="#areas">Ver áreas de práctica</a>
          </div>
        </div>
        <Image
          class="hero__img"
          src={justicia}
          alt="Palacio de Justicia de la provincia de Mendoza"
          widths={[520, 760, 1000]}
          sizes="(min-width: 900px) 44vw, 92vw"
          format="webp"
          quality={70}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="facts">
      <div class="wrap facts__grid">
        <div><p class="facts__v">1998</p><p class="facts__k">Año de fundación</p></div>
        <div><p class="facts__v">Sin cargo</p><p class="facts__k">Primera consulta</p></div>
        <div><p class="facts__v">24 horas</p><p class="facts__k">Plazo de respuesta</p></div>
        <div><p class="facts__v">Mendoza y San Rafael</p><p class="facts__k">Dónde atendemos</p></div>
      </div>
    </section>

    <section class="section" id="areas">
      <div class="wrap">
        <h2 class="h2">Áreas de práctica</h2>
        <div class="areas">
          {areas.map((a) => (
            <article class="area">
              <h3 class="area__t">{a.name}</h3>
              <p class="area__b">{a.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="trabajo">
      <div class="wrap">
        <h2 class="h2 h2--light">Cómo trabajamos</h2>
        <div class="steps">
          {steps.map((s) => (
            <div class="step">
              <h3 class="step__t">{s.t}</h3>
              <p class="step__b">{s.b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="equipo">
      <div class="wrap equipo__grid">
        <div>
          <h2 class="h2">El equipo</h2>
          <ul class="team">
            {team.map((m) => (
              <li class="team__row">
                <p class="team__name">{m.name}</p>
                <p class="team__role">{m.role}</p>
                <p class="team__extra">{m.extra}</p>
              </li>
            ))}
          </ul>
        </div>
        <Image
          class="equipo__img"
          src={fachada}
          alt="Fachada del Palacio de Justicia de Mendoza"
          widths={[480, 700]}
          sizes="(min-width: 900px) 40vw, 92vw"
          format="webp"
          quality={68}
          loading="lazy"
        />
      </div>
    </section>

    <section class="section consulta" id="consulta">
      <div class="wrap consulta__grid">
        <div>
          <h2 class="h2">Pedir una consulta</h2>
          <p class="consulta__lede">
            Contanos en dos líneas qué te pasa. Te respondemos dentro de las 24 horas
            hábiles y coordinamos la primera reunión, que no se cobra.
          </p>
          <p class="consulta__note">
            Lo que nos cuentes queda bajo secreto profesional desde el primer mensaje,
            seamos o no tus abogados después.
          </p>
          <dl class="consulta__data">
            <div><dt>Dirección</dt><dd>Av. España 1200, piso 4, Ciudad de Mendoza</dd></div>
            <div><dt>Teléfono</dt><dd>+54 261 000 0000</dd></div>
            <div><dt>Horario</dt><dd>Lunes a viernes, de 9 a 18</dd></div>
          </dl>
        </div>

        <form class="form" method="dialog">
          <div class="field">
            <label for="e-nombre">Nombre y apellido</label>
            <input id="e-nombre" name="nombre" type="text" required />
          </div>
          <div class="row2">
            <div class="field">
              <label for="e-email">Email</label>
              <input id="e-email" name="email" type="email" required />
            </div>
            <div class="field">
              <label for="e-tel">Teléfono</label>
              <input id="e-tel" name="telefono" type="tel" />
            </div>
          </div>
          <div class="field">
            <label for="e-area">Sobre qué tema</label>
            <select id="e-area" name="area">
              {areas.map((a) => <option>{a.name}</option>)}
              <option>Otro</option>
            </select>
          </div>
          <div class="field">
            <label for="e-msg">Contanos brevemente</label>
            <textarea id="e-msg" name="mensaje" rows="5" required></textarea>
          </div>
          <button class="btn btn--lg" type="submit">Enviar consulta</button>
          <p class="form__note">Este formulario es parte de un ejemplo y no envía nada.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap ftr__grid">
      <div>
        <p class="ftr__brand">Ávila Nieto Abogados</p>
        <p class="ftr__line">Av. España 1200, piso 4, Ciudad de Mendoza</p>
      </div>
      <p class="ftr__credits">
        Fotos: Vsottano y Ccarosio (CC BY-SA 3.0), vía Wikimedia Commons.
      </p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  :root {
    --navy: #16233f;
    --navy-soft: #2b3c60;
    --paper: #f6f6f3;
    --white: #ffffff;
    --cobalt: #1f4ea8;
    --muted: #545d6e;
    --line: #dcdcd6;
    --ui: 'Instrument Sans Variable', ui-sans-serif, system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; }

  body {
    background: var(--paper);
    color: var(--navy);
    font-family: var(--ui);
    font-size: 1.02rem;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
  }

  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  button, input, textarea, select { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }

  .wrap { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 1.25rem; }
  .section { padding-block: clamp(3.5rem, 8vw, 6rem); }

  .h2 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
    max-width: 20ch;
  }
  .h2--light { color: var(--white); }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cobalt);
    color: var(--white);
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--cobalt);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .btn:hover { background: #1a4290; }
  .btn:active { transform: translateY(1px); }
  .btn--lg { padding: 0.9rem 1.5rem; }

  .link {
    color: var(--cobalt);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    font-weight: 500;
  }

  /* Nav ------------------------------------------------------------------ */
  .nav { background: var(--white); border-bottom: 1px solid var(--line); }
  .nav__inner { display: flex; align-items: center; gap: 1.25rem; height: 76px; }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: var(--navy);
    color: var(--white);
    border-radius: 4px;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
  .nav__sub { color: var(--muted); font-weight: 400; }
  .nav__links { display: none; gap: 1.5rem; margin-left: auto; font-size: 0.95rem; color: var(--muted); }
  .nav__links a { text-decoration: none; }
  .nav__links a:hover { color: var(--navy); }
  .nav__cta { margin-left: auto; font-size: 0.9rem; padding: 0.55rem 1rem; }
  @media (min-width: 900px) {
    .nav__links { display: flex; }
    .nav__cta { margin-left: 0; }
  }

  /* Hero ----------------------------------------------------------------- */
  .hero { background: var(--white); border-bottom: 1px solid var(--line); }
  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .hero__title {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.7rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 15ch;
  }
  .hero__sub { margin-top: 1.2rem; color: var(--muted); font-size: 1.12rem; max-width: 46ch; }
  .hero__cta { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .hero__img { border-radius: 4px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1.15fr 0.85fr; gap: 3.5rem; }
  }

  /* Facts ---------------------------------------------------------------- */
  .facts { background: var(--paper); border-bottom: 1px solid var(--line); }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    padding-block: 2rem;
  }
  .facts__v { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; }
  .facts__k { margin-top: 0.1rem; font-size: 0.85rem; color: var(--muted); }
  @media (min-width: 820px) { .facts__grid { grid-template-columns: repeat(4, 1fr); } }

  /* Areas ---------------------------------------------------------------- */
  .areas { margin-top: 2.5rem; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
  .area { background: var(--white); padding: 1.5rem; }
  .area__t { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; }
  .area__b { margin-top: 0.5rem; color: var(--muted); font-size: 0.96rem; }
  @media (min-width: 700px) { .areas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .areas { grid-template-columns: repeat(3, 1fr); } }

  /* Band ----------------------------------------------------------------- */
  .band { background: var(--navy); color: #dfe4ee; padding-block: clamp(3.5rem, 8vw, 5.5rem); }
  .steps { margin-top: 2.5rem; display: grid; gap: 2rem; }
  .step__t { color: var(--white); font-size: 1.15rem; font-weight: 600; }
  .step__b { margin-top: 0.5rem; color: #b9c4da; max-width: 40ch; }
  @media (min-width: 860px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }

  /* Equipo --------------------------------------------------------------- */
  .equipo__grid { display: grid; gap: 2.5rem; align-items: center; }
  .team { margin-top: 2rem; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .team__row { padding-block: 1.2rem; border-bottom: 1px solid var(--line); }
  .team__name { font-weight: 600; font-size: 1.1rem; }
  .team__role { color: var(--cobalt); font-size: 0.92rem; }
  .team__extra { margin-top: 0.3rem; color: var(--muted); font-size: 0.88rem; }
  .equipo__img { border-radius: 4px; }
  @media (min-width: 900px) { .equipo__grid { grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; } }

  /* Consulta ------------------------------------------------------------- */
  .consulta { background: var(--white); border-top: 1px solid var(--line); }
  .consulta__grid { display: grid; gap: 2.5rem; }
  .consulta__lede { margin-top: 1rem; color: var(--muted); max-width: 46ch; }
  .consulta__note {
    margin-top: 1.2rem;
    padding-left: 1rem;
    border-left: 3px solid var(--cobalt);
    color: var(--navy);
    font-size: 0.95rem;
    max-width: 46ch;
  }
  .consulta__data { margin-top: 2rem; display: grid; gap: 0.8rem; }
  .consulta__data dt { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
  .consulta__data dd { margin: 0; }

  .row2 { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.35rem; margin-bottom: 1rem; }
  .field label { font-size: 0.88rem; color: var(--muted); }
  .field input, .field textarea, .field select {
    background: var(--paper);
    border: 1px solid #b6bac2;
    border-radius: 4px;
    padding: 0.65rem 0.8rem;
    width: 100%;
  }
  .field textarea { resize: vertical; }
  .form__note { margin-top: 0.9rem; font-size: 0.84rem; color: var(--muted); }
  @media (min-width: 860px) {
    .consulta__grid { grid-template-columns: 0.95fr 1.05fr; gap: 3.5rem; }
    .row2 { grid-template-columns: 1fr 1fr; }
  }

  /* Footer --------------------------------------------------------------- */
  .ftr { background: var(--navy); color: #c3cde0; padding-block: 2.2rem; }
  .ftr__grid { display: grid; gap: 1.2rem; }
  .ftr__brand { color: var(--white); font-weight: 600; font-size: 1.1rem; }
  .ftr__line { margin-top: 0.2rem; font-size: 0.9rem; }
  .ftr__credits { font-size: 0.8rem; }
  @media (min-width: 800px) { .ftr__grid { grid-template-columns: 1fr auto; align-items: end; } }
</style>
