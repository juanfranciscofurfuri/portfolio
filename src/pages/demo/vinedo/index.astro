---
import { Image } from 'astro:assets';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/outfit';
import hero from '../../../assets/demo-lodge/hero.jpg';
import mountains from '../../../assets/demo-lodge/mountains.jpg';
import vineyard from '../../../assets/demo-lodge/vineyard.jpg';
import rows from '../../../assets/demo-lodge/rows.jpg';

const rooms = [
  {
    name: 'Cordón',
    img: mountains,
    alt: 'Vista al Cordón del Plata nevado',
    view: 'Mira al Cordón del Plata',
    detail: 'Dos personas. Cama king, baño con bañera, estufa a leña.',
    price: 'USD 145 la noche',
  },
  {
    name: 'Viñedo',
    img: vineyard,
    alt: 'Viñedos con el Cordón del Plata de fondo',
    view: 'Mira a los viñedos',
    detail: 'Dos personas. Cama king, galería propia con reposeras.',
    price: 'USD 130 la noche',
  },
  {
    name: 'Parral',
    img: rows,
    alt: 'Hileras de viñedo en Tupungato',
    view: 'Mira al parral y la huerta',
    detail: 'Hasta cuatro personas. Dos ambientes, para familia.',
    price: 'USD 175 la noche',
  },
];

const experiences = [
  {
    title: 'Bodegas del Valle de Uco',
    body: 'Coordinamos la visita y el traslado. Tres bodegas a menos de veinte minutos, con degustación y almuerzo.',
  },
  {
    title: 'Cabalgata al atardecer',
    body: 'Salida de dos horas por los caminos entre fincas, con un guía de la zona. Se sale a las siete.',
  },
  {
    title: 'Cocina de campo',
    body: 'Cena de tres pasos con lo que hay en la huerta esa semana. Jueves y sábados, para diez personas.',
  },
];
---

<DemoLayout
  title="Casa Ladera - Posada en Tupungato, Valle de Uco"
  description="Posada de campo con cuatro habitaciones en Tupungato, Valle de Uco. Consultá disponibilidad."
  path="demo/vinedo"
  themeColor="#3d4a33"
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="nav__brand" href="#top">Casa Ladera</a>
      <nav class="nav__links" aria-label="Secciones">
        <a href="#habitaciones">Habitaciones</a>
        <a href="#experiencias">Experiencias</a>
        <a href="#casa">La casa</a>
        <a href="#llegar">Cómo llegar</a>
      </nav>
      <a class="btn nav__cta" href="#consultar">Consultar disponibilidad</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <Image
        class="hero__bg"
        src={hero}
        alt="Viñedos de Tupungato con la cordillera nevada de fondo"
        widths={[900, 1400, 1800]}
        sizes="100vw"
        format="webp"
        quality={70}
        loading="eager"
        fetchpriority="high"
      />
      <div class="wrap hero__inner">
        <p class="hero__where">Tupungato, Valle de Uco</p>
        <h1 class="hero__title">Cuatro habitaciones al pie del Cordón del Plata</h1>
        <p class="hero__sub">
          Posada de campo entre viñedos, a veinte minutos de las bodegas del valle.
        </p>
        <a class="btn btn--lg" href="#consultar">Consultar disponibilidad</a>
      </div>
    </section>

    <section class="strip">
      <div class="wrap strip__grid">
        <div><p class="strip__k">Habitaciones</p><p class="strip__v">Cuatro, todas con vista</p></div>
        <div><p class="strip__k">Desayuno</p><p class="strip__v">Incluido, de la huerta</p></div>
        <div><p class="strip__k">Distancia</p><p class="strip__v">20 min de las bodegas</p></div>
        <div><p class="strip__k">Mínimo</p><p class="strip__v">Dos noches en temporada</p></div>
      </div>
    </section>

    <section class="section" id="habitaciones">
      <div class="wrap">
        <h2 class="h2">Cada habitación mira a algo distinto</h2>
        <p class="section__lede">
          La casa se apoya contra la ladera, así que ninguna ventana da a lo mismo.
        </p>

        <div class="rooms">
          {rooms.map((room) => (
            <article class="room">
              <Image
                class="room__img"
                src={room.img}
                alt={room.alt}
                widths={[420, 640]}
                sizes="(min-width: 900px) 32vw, 92vw"
                format="webp"
                quality={68}
                loading="lazy"
              />
              <div class="room__body">
                <h3 class="room__name">{room.name}</h3>
                <p class="room__view">{room.view}</p>
                <p class="room__detail">{room.detail}</p>
                <p class="room__price">{room.price}</p>
                <a class="link" href="#consultar">Consultar esta habitación</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="quote">
      <div class="wrap">
        <blockquote class="quote__text">
          Nos fuimos con la sensación de haber estado en la casa de alguien, no en un hotel.
        </blockquote>
        <p class="quote__by">Marcela Ibarguren, Rosario. Febrero de 2026.</p>
      </div>
    </section>

    <section class="section" id="experiencias">
      <div class="wrap">
        <h2 class="h2">Qué se puede hacer desde acá</h2>
        <dl class="exp">
          {experiences.map((e) => (
            <div class="exp__row">
              <dt class="exp__t">{e.title}</dt>
              <dd class="exp__b">{e.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="casa" id="casa">
      <div class="wrap casa__grid">
        <div class="casa__copy">
          <h2 class="h2">La casa</h2>
          <p>
            La levantaron en 1974 como casco de una finca de treinta hectáreas. Sigue
            en pie la galería original y el parral que le da sombra al patio.
          </p>
          <p>
            Las cuatro habitaciones son del ala norte, que sumamos el año pasado. Se
            cocina con leña y con lo que da la huerta.
          </p>
        </div>
        <Image
          class="casa__img"
          src={vineyard}
          alt="Viñedos y cordillera vistos desde la finca"
          widths={[520, 760]}
          sizes="(min-width: 900px) 46vw, 92vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </div>
    </section>

    <section class="section form-section" id="consultar">
      <div class="wrap form__grid">
        <div>
          <h2 class="h2">Consultá disponibilidad</h2>
          <p class="section__lede">
            Contanos qué fechas tenés en mente y te respondemos el mismo día con lo que hay libre.
          </p>
          <p class="form__aside">
            También por teléfono, de 9 a 20: <span class="mono">+54 261 000 0000</span>
          </p>
        </div>

        <form class="form" method="dialog">
          <div class="row2">
            <div class="field">
              <label for="l-nombre">Nombre</label>
              <input id="l-nombre" name="nombre" type="text" required />
            </div>
            <div class="field">
              <label for="l-email">Email</label>
              <input id="l-email" name="email" type="email" required />
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="l-desde">Llegada</label>
              <input id="l-desde" name="desde" type="date" required />
            </div>
            <div class="field">
              <label for="l-hasta">Salida</label>
              <input id="l-hasta" name="hasta" type="date" required />
            </div>
          </div>
          <div class="field">
            <label for="l-personas">Personas</label>
            <select id="l-personas" name="personas">
              <option>1</option>
              <option selected>2</option>
              <option>3</option>
              <option>4</option>
            </select>
          </div>
          <div class="field">
            <label for="l-msg">Algo que debamos saber</label>
            <textarea id="l-msg" name="mensaje" rows="4"></textarea>
          </div>
          <button class="btn btn--lg form__submit" type="submit">Enviar consulta</button>
          <p class="form__note">Este formulario es parte de un ejemplo y no envía nada.</p>
        </form>
      </div>
    </section>

    <section class="section llegar" id="llegar">
      <div class="wrap">
        <h2 class="h2">Cómo llegar</h2>
        <div class="llegar__grid">
          <p>
            Ruta Provincial 89, kilómetro 12, Tupungato. Desde la ciudad de Mendoza son
            unos 80 kilómetros por la Ruta 40 y después la 86.
          </p>
          <p>
            El último tramo son tres kilómetros de camino de tierra, firme todo el año.
            Si venís de noche avisanos y te esperamos en la tranquera.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap">
      <p class="ftr__brand">Casa Ladera</p>
      <p class="ftr__credits">
        Fotos: Daniel Velasquez (CC BY-SA 4.0), Leandro Kibisz (CC BY-SA 4.0) y
        Federico Gomez Aghetta (dominio público), vía Wikimedia Commons.
      </p>
    </div>
  </footer>
</DemoLayout>

<style is:global>
  :root {
    --paper: #f3f4f0;
    --ink: #1c2019;
    --olive: #3d4a33;
    --olive-soft: #55634a;
    --brick: #a8412c;
    --line: #d9dcd2;
    --display: 'EB Garamond Variable', Georgia, serif;
    --ui: 'Outfit Variable', ui-sans-serif, system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--ui);
    font-size: 1.02rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  button, input, textarea, select { font: inherit; color: inherit; }

  :focus-visible { outline: 2px solid var(--brick); outline-offset: 3px; }

  .wrap { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 1.25rem; }
  .section { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .mono { font-variant-numeric: tabular-nums; }

  .h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 20ch;
  }

  .section__lede {
    margin-top: 0.9rem;
    color: var(--olive-soft);
    max-width: 52ch;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brick);
    color: #fff;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--brick);
    border-radius: 2px;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .btn:hover { background: #8f3624; }
  .btn:active { transform: translateY(1px); }
  .btn--lg { padding: 0.9rem 1.6rem; }

  .link {
    color: var(--brick);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    font-size: 0.92rem;
  }

  /* Nav ------------------------------------------------------------------ */
  .nav { border-bottom: 1px solid var(--line); background: var(--paper); }
  .nav__inner { display: flex; align-items: center; gap: 1.25rem; height: 72px; }
  .nav__brand {
    font-family: var(--display);
    font-size: 1.45rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .nav__links { display: none; gap: 1.4rem; margin-left: auto; font-size: 0.94rem; }
  .nav__links a { text-decoration: none; color: var(--olive-soft); }
  .nav__links a:hover { color: var(--ink); }
  .nav__cta { margin-left: auto; font-size: 0.9rem; padding: 0.55rem 1rem; }

  @media (min-width: 900px) {
    .nav__links { display: flex; }
    .nav__cta { margin-left: 0; }
  }

  /* Hero ----------------------------------------------------------------- */
  .hero { position: relative; isolation: isolate; }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 25, 17, 0.74), rgba(20, 25, 17, 0.5));
  }
  .hero__inner {
    padding-block: clamp(4rem, 12vw, 8.5rem);
    color: #fff;
  }
  .hero__where {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #e6e3d8;
  }
  .hero__title {
    margin-top: 0.8rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.4rem, 1.4rem + 4.2vw, 4.3rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    max-width: 23ch;
  }
  .hero__sub { margin-top: 1rem; max-width: 40ch; color: #eae8df; font-size: 1.1rem; }
  .hero__inner .btn { margin-top: 1.8rem; }

  /* Strip ---------------------------------------------------------------- */
  .strip { background: var(--olive); color: #eef0e8; }
  .strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
    padding-block: 1.6rem;
  }
  .strip__k {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #c3ceb6;
  }
  .strip__v { margin-top: 0.2rem; font-weight: 500; }
  @media (min-width: 800px) { .strip__grid { grid-template-columns: repeat(4, 1fr); } }

  /* Rooms ---------------------------------------------------------------- */
  .rooms { margin-top: 2.5rem; display: grid; gap: 1.6rem; }
  .room { border: 1px solid var(--line); border-radius: 2px; background: #fff; overflow: hidden; }
  .room__img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .room__body { padding: 1.3rem; }
  .room__name { font-family: var(--display); font-weight: 500; font-size: 1.7rem; line-height: 1.1; }
  .room__view { margin-top: 0.2rem; color: var(--brick); font-size: 0.9rem; }
  .room__detail { margin-top: 0.7rem; color: var(--olive-soft); font-size: 0.95rem; }
  .room__price { margin-top: 0.9rem; font-weight: 500; }
  .room__body .link { display: inline-block; margin-top: 1rem; }
  @media (min-width: 900px) { .rooms { grid-template-columns: repeat(3, 1fr); } }

  /* Quote ---------------------------------------------------------------- */
  .quote { background: #fff; border-block: 1px solid var(--line); padding-block: clamp(3rem, 6vw, 4.5rem); }
  .quote__text {
    font-family: var(--display);
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2rem);
    line-height: 1.3;
    max-width: 26ch;
  }
  .quote__by { margin-top: 1rem; color: var(--olive-soft); font-size: 0.9rem; }

  /* Experiences ---------------------------------------------------------- */
  .exp { margin-top: 2rem; border-top: 1px solid var(--line); }
  .exp__row { display: grid; gap: 0.4rem; padding-block: 1.4rem; border-bottom: 1px solid var(--line); }
  .exp__t { font-family: var(--display); font-size: 1.4rem; font-weight: 500; }
  .exp__b { margin: 0; color: var(--olive-soft); max-width: 58ch; }
  @media (min-width: 800px) {
    .exp__row { grid-template-columns: 1fr 1.5fr; gap: 2rem; padding-block: 1.8rem; }
  }

  /* Casa ----------------------------------------------------------------- */
  .casa { background: #fff; border-block: 1px solid var(--line); padding-block: clamp(3.5rem, 8vw, 6rem); }
  .casa__grid { display: grid; gap: 2rem; align-items: center; }
  .casa__copy p { margin-top: 1rem; color: var(--olive-soft); max-width: 48ch; }
  .casa__img { border-radius: 2px; }
  @media (min-width: 900px) { .casa__grid { grid-template-columns: 1fr 1fr; gap: 3rem; } }

  /* Form ----------------------------------------------------------------- */
  .form-section { background: var(--paper); }
  .form__grid { display: grid; gap: 2.5rem; }
  .form__aside { margin-top: 1.5rem; color: var(--olive-soft); font-size: 0.95rem; }
  .row2 { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.35rem; margin-bottom: 1rem; }
  .field label { font-size: 0.88rem; color: var(--olive-soft); }
  .field input, .field textarea, .field select {
    background: #fff;
    border: 1px solid #b9bfb0;
    border-radius: 2px;
    padding: 0.65rem 0.8rem;
    width: 100%;
  }
  .field textarea { resize: vertical; }
  .form__note { margin-top: 0.9rem; font-size: 0.84rem; color: var(--olive-soft); }
  @media (min-width: 860px) {
    .form__grid { grid-template-columns: 0.9fr 1.1fr; gap: 3.5rem; }
    .row2 { grid-template-columns: 1fr 1fr; }
  }

  /* Llegar --------------------------------------------------------------- */
  .llegar { border-top: 1px solid var(--line); }
  .llegar__grid { margin-top: 1.5rem; display: grid; gap: 1.2rem; color: var(--olive-soft); }
  @media (min-width: 800px) { .llegar__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }

  /* Footer --------------------------------------------------------------- */
  .ftr { background: var(--olive); color: #dfe4d8; padding-block: 2rem; }
  .ftr__brand { font-family: var(--display); font-size: 1.4rem; color: #fff; }
  .ftr__credits { margin-top: 0.6rem; font-size: 0.8rem; max-width: 70ch; }
</style>
